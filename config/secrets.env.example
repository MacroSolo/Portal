# Portal secrets template (same format as Merlin config/secrets.env).
# Copy to config/secrets.env and fill in real values:
#   cp config/secrets.env.example config/secrets.env
# config/secrets.env is in .gitignore and must never be committed.
# Format: KEY=value, no quotes, no spaces around "=".

########################
# AWS                  #
########################
AWS_REGION=eu-central-1

# IAM user for S3 (was the Lambda config s3_id / s3_secret)
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
S3_BUCKET=merlin-ds

########################
# MQTT (HiveMQ Cloud)  #
########################
# Command topic for main.py (s3/<label> -> frame series to S3)
MQTT_HOST=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=portal/commands

########################
# GitHub (pull)        #
########################
# Read-only token for portal_autogit.py (polls GitHub for new commits on main)
GITHUB_READ_USER=
GITHUB_READ_TOKEN=

########################
# GitHub (push)        #
########################
# DEVELOPMENT ONLY: for git_push.py on a developer machine.
# Do NOT copy these values to devices: leave them empty in secrets.env on devices.
GITHUB_PUSH_USER=
GITHUB_PUSH_TOKEN=
